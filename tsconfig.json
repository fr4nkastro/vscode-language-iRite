{
	"compilerOptions": {
		"module": "commonjs",
		"target": "es2022",
		"lib": ["es2022"],
		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
		"noEmit": true,
		"types": ["node", "vscode"]
	},
	"include": ["src/**/*.ts", "test/**/*.ts"]
}
